# Razorpay Configuration
# Get your keys from: https://dashboard.razorpay.com/app/keys

# Public key (used in frontend)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# Secret key (BACKEND ONLY - Never expose to frontend)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Webhook secret (BACKEND ONLY - Get from Razorpay webhook settings)
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# Supabase Configuration
# Get from: https://app.supabase.com/project/_/settings/api

# Public Supabase URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# Anon/Public key (safe for frontend with RLS enabled)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (BACKEND ONLY - Full database access)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Application Configuration
VITE_APP_NAME="Your Restaurant Name"
VITE_APP_URL=https://yoursite.vercel.app

# For Vercel deployment, add these as environment variables:
# - RAZORPAY_KEY_SECRET (Backend only)
# - RAZORPAY_WEBHOOK_SECRET (Backend only)
# - SUPABASE_SERVICE_KEY (Backend only)
# - All VITE_ prefixed variables (Frontend + Backend)